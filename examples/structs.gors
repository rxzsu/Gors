struct Point {
    x: int,
    y: int,
}

fn dist2(p: &Point) -> int {
    return p.x * p.x + p.y * p.y
}

fn shift(p: &mut Point, dx: int, dy: int) {
    p.x = p.x + dx
    p.y = p.y + dy
}

fn main() {
    let mut p = Point { x: 3, y: 4 }
    println(dist2(&p))
    shift(&mut p, 1, 1)
    println(p.x)
    println(p.y)
}
