fn main() {
    let mut i = 0
    let mut sum = 0

    println("Testing continue:")
    while i < 10 {
        i = i + 1
        if i % 2 == 0 {
            continue
        }
        println(i)
        sum = sum + i
    }
    println("Sum of odds:")
    println(sum)

    println("Testing break:")
    while true {
        let message = "loop step"
        if sum > 30 {
            println("breaking out")
            break
        }
        sum = sum + 10
        println(message)
    }
    println("Final sum:")
    println(sum)
}
